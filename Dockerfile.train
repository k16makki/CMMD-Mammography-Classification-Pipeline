# Dockerfile.train
FROM python:3.10-slim

# Install minimal system deps (same as your base)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy your shared requirements (used by download + preprocessing + training)
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy dev/optional requirements (TensorFlow + training deps)
COPY requirements.dev.txt ./requirements.dev.txt
RUN pip install --no-cache-dir -r requirements.dev.txt

# Copy your source code
COPY src/ /app/src/

# Data will be mounted at runtime
VOLUME ["/data"]

# Default: run the training script
ENTRYPOINT ["python", "/app/src/train_mammo.py"]
